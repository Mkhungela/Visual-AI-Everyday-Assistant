    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts && tsx tests/dom.tsx",
    "test:logic": "tsx tests/run.ts",
    "test:dom": "tsx tests/dom.tsx"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=20"
  }
